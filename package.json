{
  "name": "a-ultima-companhia",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Survivors-like 2D dark fantasy para navegador.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "content:validate": "node scripts/validators/validate-content.mjs",
    "assets:plan": "node scripts/asset-generation/plan.mjs --dry-run",
    "assets:generate": "node scripts/asset-generation/generate.mjs",
    "assets:process": "node scripts/asset-processing/process.mjs",
    "assets:validate": "node scripts/validators/validate-assets.mjs",
    "assets:atlas": "node scripts/atlas-builder/build.mjs",
    "assets:report": "node scripts/validators/asset-report.mjs",
    "simulate": "node scripts/balance/simulate.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run content:validate && npm run assets:validate && npm run build"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.10.13",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
